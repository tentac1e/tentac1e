# Гид по базилику — адреса без «.html» (Apache: REG.RU и большинство обычных хостингов)
#
#   ваш-сайт/sorta        показывает sorta.html, в адресной строке остаётся /sorta
#   ваш-сайт/sorta.html   навсегда (301) переводит на /sorta — старые ссылки и закладки не ломаются
#   ваш-сайт/sorta/       переводит на /sorta
#   ваш-сайт/index.html   переводит на главную /
#
# Файл рассчитан на сайт в корне домена. Если сайт лежит в подпапке, например ваш-сайт/bazilik/,
# впишите её в строку RewriteBase ниже: RewriteBase /bazilik/

# кириллица в страницах, стилях и скриптах — всегда UTF-8, какой бы кодировка ни стояла на сервере
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js

RewriteEngine On
RewriteBase /

# /index.html и /index → /
RewriteCond %{THE_REQUEST} \s/+(.*?/)?index(\.html)?[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# /sorta.html → /sorta (только прямые запросы из браузера, не внутренние подстановки ниже)
RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# /sorta/ → /sorta, если такой папки нет (иначе сломались бы пути к assets)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ $1 [R=301,L]

# /sorta → sorta.html внутри сервера, адрес в браузере не меняется
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
